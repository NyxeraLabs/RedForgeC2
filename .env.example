# Copy to `.env` and fill values for local development (do not commit `.env`).
#
# Docker Compose loads `.env` from the current working directory. If you run:
#   docker compose -f docker/docker-compose.yml up
# from repo root, place `.env` at repo root.

# Teamserver
REDFORGE_PORT=9080
REDFORGE_JWT_SECRET=change_me_to_a_long_random_value
REDFORGE_ADMIN_USER=admin
REDFORGE_ADMIN_PASS=change_me_to_a_strong_password
# Set to 1 to reset the admin password on teamserver startup (dev only).
REDFORGE_ADMIN_RESET=0
REDFORGE_TOKEN_EXPIRY_MIN=60

# Postgres (docker-compose)
REDFORGE_DB_USER=redforge
REDFORGE_DB_PASS=change_me_to_a_strong_password
REDFORGE_DB_NAME=redforge

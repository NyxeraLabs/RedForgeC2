# Copy to `.env` and fill values for local development (do not commit `.env`).

# Teamserver
REDFORGE_PORT=9080
REDFORGE_JWT_SECRET=change_me_to_a_long_random_value
REDFORGE_ADMIN_USER=admin
REDFORGE_ADMIN_PASS=change_me
REDFORGE_TOKEN_EXPIRY_MIN=60

# Postgres (docker-compose)
REDFORGE_DB_USER=redforge
REDFORGE_DB_PASS=change_me
REDFORGE_DB_NAME=redforge
